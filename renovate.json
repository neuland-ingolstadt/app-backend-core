{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>neuland-ingolstadt/renovate-config:quarkus"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automerge": true,
  "packageRules": [
    {
      "description": "Ship backend contract updates immediately (no release-age or schedule delay)",
      "matchPackageNames": ["app.neuland:backend-core-api-**"],
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ]
}
